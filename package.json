{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "build:prod": "bash deploy/build-production.sh",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "test:pm2-safety": "node --test deploy/test-pm2-safety.cjs",
    "test:data-boundaries": "node --test deploy/test-data-boundaries.cjs",
    "audit:tenant-writers": "node scripts/audit-tenant-writers.mjs",
    "audit:legacy-role-gates": "node scripts/audit-legacy-role-gates.mjs",
    "test:e2e": "E2E_ALLOW_DATABASE_MUTATION=1 PLAYWRIGHT_BASE_URL=http://localhost:25197 playwright test",
    "portal:dry": "pnpm --filter @workspace/portal-automation-worker run portal:dry"
  },
  "private": true,
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "packageManager": "pnpm@10.33.2"
}
